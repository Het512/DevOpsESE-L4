pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo "📦 Cloning repository..."
                git branch: 'main', url: 'https://github.com/Het512/jenkins-basic-ci.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "🐳 Building Docker image..."
                sh 'docker build -t jenkins-basic-ci .'
            }
        }

        stage('Run Container') {
            steps {
                echo "🚀 Running Docker container..."
                sh '''
                docker rm -f jenkins-basic-ci-container || true
                docker run -d -p 5000:5000 --name jenkins-basic-ci-container jenkins-basic-ci
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Build and container run successful!"
        }
        failure {
            echo "❌ Build failed. Check the console output for errors."
        }
    }
}